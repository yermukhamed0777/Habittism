    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "1.65.1",
